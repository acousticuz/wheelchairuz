# ============================================================
#  wheelchair.uz — Backend Environment Configuration
#  Bu faylni nusxa olib .env deb nomlang va to'ldiring:
#    cp .env.example .env
# ============================================================

# ── Server ───────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ── PostgreSQL Database ───────────────────────────────────────
# PostgreSQL serveringizning ma'lumotlari
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=YOUR_POSTGRES_PASSWORD_HERE
DB_DATABASE=wheelchair_db

# TypeORM: birinchi ishga tushirganda true, keyin false qiling
DB_SYNC=false
DB_LOGGING=false

# Cloud Postgres (SSL). Oddiy lokal/docker Postgres: false
DB_SSL=false
# DB_SSL=true va kerak bo'lsa: DB_SSL_REJECT_UNAUTHORIZED=false

# ── JWT Authentication ────────────────────────────────────────
# Uzun va murakkab tasodifiy satr kiriting (kamida 64 belgi)
JWT_SECRET=YOUR_SUPER_SECRET_JWT_KEY_CHANGE_THIS_IN_PRODUCTION_MIN_64_CHARS
JWT_EXPIRES_IN=7d

# ── Admin Credentials (birinchi ishga tushganda yaratiladi) ───
ADMIN_EMAIL=admin@wheelchair.uz
ADMIN_PASSWORD=CHANGE_ME_TO_A_STRONG_ADMIN_PASSWORD
ADMIN_NAME=Admin

# ── Telegram Bot ──────────────────────────────────────────────
# @BotFather dan olingan token
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# So'rovlar (inquiries) keladigan Telegram chat ID
# Botni guruhga qo'shib /start bosing, keyin chat ID ni oling
TELEGRAM_ADMIN_CHAT_ID=YOUR_TELEGRAM_CHAT_ID_HERE

# ── File Upload ───────────────────────────────────────────────
# Rasmlar saqlanadigan papka (server ichida)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=5242880

# ── Frontend URL (CORS uchun) ─────────────────────────────────
FRONTEND_URL=https://wheelchair.uz
ADMIN_URL=https://admin.wheelchair.uz

# ── Swagger API Docs ──────────────────────────────────────────
# production da false qiling yoki umuman yozmang (production default: false)
SWAGGER_ENABLED=false
