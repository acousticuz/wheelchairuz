# Loyiha ildizidan nusxa:  cp deploy.env.example .env.production
# docker-compose.prod.yml bu faylni backend konteyneriga uzatadi.

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── PostgreSQL (tashqi server yoki VPS dagi DB) ─────────────
DB_HOST=YOUR_DB_HOST
DB_PORT=5432
DB_USERNAME=YOUR_DB_USER
DB_PASSWORD=YOUR_DB_PASSWORD
DB_DATABASE=wheelchair_db

# Yangi migratsiyasiz ish: bir marta true, skehma tayyor bo'lsa har doim false
DB_SYNC=false
DB_LOGGING=false

# Cloud Postgres (RDS, Supabase, ...) uchun odatda true.
# Oddiy Postgres Docker / SSL yo'q → false qoldiring.
DB_SSL=false
# Ba'zi bulutlar self-signed sertifikat uchun:
# DB_SSL=true
# DB_SSL_REJECT_UNAUTHORIZED=false

# ── JWT ───────────────────────────────────────────────────────
JWT_SECRET=GENERATE_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS
JWT_EXPIRES_IN=7d

# ── Admin (birinchi ishga tushishda seed qilinadi) ────────────
ADMIN_EMAIL=admin@wheelchair.uz
ADMIN_PASSWORD=STRONG_UNIQUE_PASSWORD
ADMIN_NAME=Admin

# ── Telegram ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── CORS: haqiqiy sayt domenlari ─────────────────────────────
FRONTEND_URL=https://wheelchair.uz
ADMIN_URL=https://wheelchair.uz

# ── Swagger: production da odatda o'chiriladi ─────────────────
SWAGGER_ENABLED=false

# ── Docker: frontend qaysi portda ochilsin (default 80) ─────
# FRONTEND_PUBLISH=80
